# 실제 값은 .env 파일에 작성하고 절대 커밋하지 않는다 (.gitignore에 이미 포함됨)
NODE_ENV=production
PORT=3000

# 클라이언트에서 감지 로그를 업로드할 API 경로
NEXT_PUBLIC_SYNC_ENDPOINT=/api/detections

# ONNX 모델 파일 경로 (public/ 기준 상대경로)
NEXT_PUBLIC_MODEL_PATH=/models/detector.onnx

# 화재/쓰러짐 등 고위험 감지 시 관리자 기기로 외부 알림(웹 푸시)을 보내는 데 필요한
# VAPID 키 쌍. `npm run generate-vapid-keys`로 생성한 뒤 아래 두 값에 붙여넣는다.
# (Oracle Cloud 같은 외부 계정 불필요 — 배포마다 고유한 키를 생성해서 쓸 것)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# web-push가 요구하는 발신자 식별자(RFC 8030) — mailto: 이메일 또는 https:// URL
VAPID_SUBJECT=mailto:admin@example.com
